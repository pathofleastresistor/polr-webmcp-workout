# Copy to `.env`. Read by `npm run dev` and by docker compose. Gitignored.

# The public origin browsers use. Must be https in any real deployment
# (WebMCP is a secure-context API — on plain http an agent sees no tools).
# No trailing slash. Use http://localhost:5173 for local development.
APP_URL=https://spotter.example.com

# Signs session cookies and OAuth state. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth 2.0 web client, from
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be exactly:
#   ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "true" to explore without Google. This is an authentication bypass:
# anyone can sign in and every visitor gets a throwaway seeded account. Leave
# blank for a real deployment.
DEMO_MODE=

# Where the SQLite database lives. Defaults to ./data/spotter.db locally; the
# container sets it to /data/spotter.db on a volume.
# DATABASE_PATH=./data/spotter.db

# --- docker compose only ------------------------------------------------------

# The domain the bundled Caddy serves and requests a certificate for.
# Must match the host in APP_URL.
SPOTTER_DOMAIN=spotter.example.com

# Host port for the app when you are not using the bundled Caddy.
# PORT=3000
